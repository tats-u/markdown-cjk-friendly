{
  "editor.defaultFormatter": "biomejs.biome",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[yaml]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "chat.tools.terminal.autoApprove": {
    "Push-Location": true,
    "Pop-Location": true,
    "/^node --run (fix|lint|build|test|bench)(:[a-z]{1,15})?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^pnpm -[CF] (\\.(\\.([/\\\\]\\.\\.){0,10})?[/\\\\])?[a-z0-9_/\\\\\\-]{1,30} (fix|lint|build|test|bench)(:[a-z]{1,15})?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^gh repo (view|read-(file|dir)|license|gitignore)\\b/": {
      "approve": true,
      "matchCommandLine": true
    },
    "gh search": true,
    "gh status": true,
    "/^gh (issue|pr) (list|view|status)\\b/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^git (status|diff|log|show|ls-files|ls-tree|rev-parse|blame|describe|shortlog)\\b/": {
      "approve": true,
      "matchCommandLine": true
    },
    "jq": true,
    "yq": true
  }
}
